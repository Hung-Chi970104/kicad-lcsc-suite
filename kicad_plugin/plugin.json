{
  "identifier": "com.easyassembly.plugin",
  "name": "EasyAssembly",
  "description": "LCSC/JLCPCB part assignment, library import and BOM/CPL output",
  "runtime": {
    "type": "exec"
  },
  "actions": [
    {
      "identifier": "open-suite",
      "name": "EasyAssembly",
      "description": "Open the EasyAssembly window",
      "show-button": true,
      "scopes": [
        "pcb"
      ],
      "entrypoint": "run.sh",
      "icons-light": [
        "icons/easyassembly-24.png",
        "icons/easyassembly-48.png"
      ],
      "icons-dark": [
        "icons/easyassembly-dark-24.png",
        "icons/easyassembly-dark-48.png"
      ]
    }
  ]
}
