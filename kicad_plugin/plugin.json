{
  "identifier": "com.lcscsuite.plugin",
  "name": "LCSC Suite",
  "description": "LCSC/JLCPCB part assignment, library import and BOM/CPL output",
  "runtime": {
    "type": "exec"
  },
  "actions": [
    {
      "identifier": "open-suite",
      "name": "LCSC Suite",
      "description": "Open the LCSC Suite window",
      "show-button": true,
      "scopes": [
        "pcb"
      ],
      "entrypoint": "run.sh",
      "icons-light": [
        "icons/lcsc-suite-24.png",
        "icons/lcsc-suite-48.png"
      ],
      "icons-dark": [
        "icons/lcsc-suite-dark-24.png",
        "icons/lcsc-suite-dark-48.png"
      ]
    }
  ]
}
