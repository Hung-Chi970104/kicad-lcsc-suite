# --- Plugin runtime data (downloaded/generated, never committed) ------------
# jlcpcb/ holds the JLCPCB parts database the plugin downloads on first use.
# current-parts-fts5.db alone is ~750 MB, far beyond GitHub's 100 MB limit.
# Delete the directory to force a fresh download.
jlcpcb/
corrections/
dev/
/settings.json

# Lib-table backups this plugin writes before editing a KiCad table
*.lcsc-suite.bak

