# Virtualenvs
.env
.venv
env/
venv/
ENV/

# --- Plugin runtime data (downloaded/generated, never committed) ------------
# jlcpcb/ holds the JLCPCB parts database the plugin downloads on first use.
# current-parts-fts5.db alone is ~750 MB, far beyond GitHub's 100 MB limit.
# Delete the directory to force a fresh download.
jlcpcb/
corrections/
dev/
# The wx plugin wrote settings.json into its own package directory. The package
# went with the Phase 8 cutover but a user's file did not, and
# config.LEGACY_SETTINGS_PATHS still imports it once so nobody sets their
# preferences twice. Ignored so that leftover does not show up as untracked in
# every checkout that predates the cutover; deleting it is safe once the app has
# run once, because the import writes to the per-user config directory.
/kicad_lcsc_suite/settings.json
/lcsc_suite/jlcpcb/

# Build output from PCM/create_pcm_archive.sh: the staging tree and the zip. The
# staging tree is a *copy of every module*, so leaving it unignored means the
# next `ruff check --extend-exclude=lib` lints the copy too — where the vendored
# lib/ sits at a path the exclusion does not match, and 21 errors appear in files
# nobody edited. ruff honours this file, so ignoring it is the fix.
/PCM/archive/
/PCM/*.zip

# Lib-table backups this plugin writes before editing a KiCad table
*.lcsc-suite.bak

# Editor / OS
.vscode/
.DS_Store
Thumbs.db
CLAUDE.local.md

# NOTE: upstream's .gitignore lists `lib/`, aimed at virtualenv lib dirs.
# This fork deliberately VENDORS code there — lib/easyeda2kicad/ and
# lib/packaging/ are tracked on purpose and must NOT be ignored.
